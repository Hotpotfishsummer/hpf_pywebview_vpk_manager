# 编辑器行为统一(所有支持 EditorConfig 的编辑器自动生效)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,vue,json,yml,yaml,html,css}]
indent_size = 2

[*.ps1]
# PowerShell 对 CRLF 更友好(避免旧版解析问题)
end_of_line = crlf

[*.md]
# markdown 行尾双空格有语义(硬换行),不裁剪
trim_trailing_whitespace = false
